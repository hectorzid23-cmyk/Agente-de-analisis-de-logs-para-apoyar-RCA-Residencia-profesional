{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "invalid_input"
      ]
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^R-[a-f0-9]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "test_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "query": {
      "type": "object",
      "properties": {
        "operation": {
          "const": "ingest_log"
        }
      },
      "required": [
        "operation"
      ],
      "additionalProperties": false
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "files_processed": {
              "type": "integer",
              "minimum": 1
            },
            "lines": {
              "type": "integer",
              "minimum": 0
            },
            "test_name_observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "file_id": {
                    "type": "string",
                    "pattern": "^F[0-9]{4,}$"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "event_id": {
                    "type": "string",
                    "pattern": "^R-[a-f0-9]{32}:F[0-9]{4,}:[1-9][0-9]*$"
                  }
                },
                "required": [
                  "value",
                  "file_id",
                  "line",
                  "event_id"
                ],
                "additionalProperties": false
              }
            },
            "format_hint": {
              "enum": [
                "uvm",
                "unknown"
              ]
            }
          },
          "required": [
            "files_processed",
            "lines",
            "test_name_observations",
            "format_hint"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "file_id": {
            "type": "string",
            "pattern": "^F[0-9]{4,}$"
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^F[0-9]{4,}$"
          },
          "log_file": {
            "type": "string"
          },
          "snapshot": {
            "type": "string"
          },
          "records": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "encoding": {
            "enum": [
              "utf-8",
              "utf-8-sig",
              "utf-16-le",
              "utf-16-be",
              "cp1252"
            ]
          },
          "line_count": {
            "type": "integer",
            "minimum": 0
          },
          "final_newline": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "known_truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "file_id",
          "log_file",
          "snapshot",
          "records",
          "sha256",
          "bytes",
          "encoding",
          "line_count",
          "final_newline",
          "known_truncated"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "run_id",
    "test_name",
    "query",
    "data",
    "warnings",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid_input"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "null"
          },
          "run_id": {
            "type": "null"
          },
          "provenance": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "object"
          },
          "run_id": {
            "type": "string",
            "pattern": "^R-[a-f0-9]{32}$"
          },
          "provenance": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
